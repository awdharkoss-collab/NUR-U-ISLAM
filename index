    <p>Kur'an-ı Kerim • Hadisler • Kıble • Mucizeler • Dualar</p>
  </header>

  <nav>
    <button class="nav-btn active" onclick="showSection('home')">Ana Sayfa</button>
    <button class="nav-btn" onclick="showSection('qibla')">Kıble</button>
