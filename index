<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nur-u Kur'an | Kur'an, Hadis & Kıble</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a1f1a;
    --card: rgba(16, 42, 35, 0.75);
    --gold: #d4af37;
    --gold-light: #f0d78c;
    --green: #1a5c45;
    --text: #e8f0ec;
    --muted: #a0b8ae;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #061510, #0a1f1a 40%, #0d2b22);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Decorative pattern */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23d4af37' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    position: relative;
    z-index: 1;
  }

  /* Header */
  header {
    text-align: center;
    padding: 40px 20px 30px;
    position: relative;
  }

  header h1 {
    font-family: 'Amiri', serif;
    font-size: 2.8rem;
    background: linear-gradient(90deg, var(--gold-light), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
    letter-spacing: 1px;
  }

  header p {
    color: var(--muted);
    font-size: 1.1rem;
  }

  /* Navigation */
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 30px 0 40px;
  }

  .nav-btn {
    background: var(--card);
    border: 1px solid rgba(212, 175, 55, 0.3);
    color: var(--text);
    padding: 12px 22px;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .nav-btn:hover, .nav-btn.active {
    background: linear-gradient(135deg, var(--green), #0f3d2e);
    border-color: var(--gold);
    color: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.2);
  }

  /* Sections */
  .section {
    display: none;
    animation: fadeIn 0.4s ease;
  }

  .section.active { display: block; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Cards */
  .card {
    background: var(--card);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 20px;
    padding: 25px;
    margin-bottom: 20px;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    transition: transform 0.3s;
  }

  .card:hover { transform: translateY(-4px); }

  .card h2, .card h3 {
    color: var(--gold);
    margin-bottom: 15px;
    font-family: 'Amiri', serif;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  /* Qibla */
  .qibla-box {
    text-align: center;
    max-width: 420px;
    margin: 0 auto;
  }

  .compass {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    border: 8px solid var(--gold);
    margin: 30px auto;
    position: relative;
    background: radial-gradient(circle, #0d2b22, #061510);
    box-shadow: 0 0 40px rgba(212, 175, 55, 0.3);
  }

  .needle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 110px;
    background: linear-gradient(to top, #c0392b, #e74c3c);
    transform-origin: bottom center;
    transform: translate(-50%, -100%) rotate(0deg);
    border-radius: 4px;
    transition: transform 0.3s ease;
  }

  .needle::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 16px;
    height: 16px;
    background: var(--gold);
    border-radius: 50%;
  }

  .kaaba-icon {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 28px;
  }

  /* Surah list */
  .surah-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: rgba(0,0,0,0.25);
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.25s;
    border: 1px solid transparent;
  }

  .surah-item:hover {
    border-color: var(--gold);
    background: rgba(26, 92, 69, 0.4);
  }

  .surah-num {
    width: 40px;
    height: 40px;
    background: var(--green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: var(--gold-light);
  }

  .badge {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 20px;
    background: rgba(212, 175, 55, 0.15);
    color: var(--gold);
  }

  .badge.medeni { background: rgba(46, 134, 193, 0.2); color: #5dade2; }

  /* Arabic text */
  .arabic {
    font-family: 'Amiri', serif;
    font-size: 1.6rem;
    line-height: 2.2;
    direction: rtl;
    text-align: right;
    color: var(--gold-light);
    margin: 20px 0;
  }

  /* Modal */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 1000;
    overflow-y: auto;
    padding: 40px 20px;
  }

  .modal-content {
    max-width: 800px;
    margin: 0 auto;
    background: var(--bg);
    border: 1px solid var(--gold);
    border-radius: 24px;
    padding: 30px;
    position: relative;
  }

  .close-btn {
    position: absolute;
    top: 20px;
    left: 20px;
    background: none;
    border: none;
    color: var(--gold);
    font-size: 1.8rem;
    cursor: pointer;
  }

  /* Hadis & Dua cards */
  .hadis-card, .dua-card {
    border-left: 4px solid var(--gold);
  }

  footer {
    text-align: center;
    padding: 40px 20px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    header h1 { font-size: 2rem; }
    .compass { width: 220px; height: 220px; }
  }
</style>
</head>
<body>
<div class="container">
  <header>
