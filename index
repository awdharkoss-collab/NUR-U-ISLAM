// ========== KIBLE HESAPLAMA ==========
const KAABA = { lat: 21.4225, lng: 39.8262 };
let qiblaAngle = 0;
let currentHeading = 0;

function toRad(d) { return d * Math.PI / 180; }
function toDeg(r) { return r * 180 / Math.PI; }

function calculateQibla(lat, lng) {
  const φ1 = toRad(lat);
  const φ2 = toRad(KAABA.lat);
  const Δλ = toRad(KAABA.lng - lng);

  const y = Math.sin(Δλ) * Math.cos(φ2);
  const x = Math.cos(φ1) * Math.sin(φ2) - Math.sin(φ1) * Math.cos(φ2) * Math.cos(Δλ);
  let bearing = toDeg(Math.atan2(y, x));
  return (bearing + 360) % 360;
}

function updateNeedle() {
  const rotation = qiblaAngle - currentHeading;
  document.getElementById('needle').style.transform = `translate(-50%, -100%) rotate(${rotation}deg)`;
}

function initQibla() {
  if (!navigator.geolocation) {
    document.getElementById('location-info').textContent = 'Konum servisi desteklenmiyor.';
    return;
  }

  navigator.geolocation.getCurrentPosition(pos => {
    const lat = pos.coords.latitude;
    const lng = pos.coords.longitude;
    qiblaAngle = calculateQibla(lat, lng);
    
    document.getElementById('location-info').textContent = 
      `Enlem: ${lat.toFixed(4)}° | Boylam: ${lng.toFixed(4)}°`;
    document.getElementById('qibla-degree').textContent = `Kıble: ${qiblaAngle.toFixed(1)}°`;
    updateNeedle();
  }, () => {
    document.getElementById('location-info').textContent = 'Konum izni verilmedi.';
  });

  // Device orientation
  if (window.DeviceOrientationEvent) {
    window.addEventListener('deviceorientationabsolute', e => {
      if (e.alpha !== null) {
        currentHeading = e.alpha;
        updateNeedle();
      }
    }, true);
    
    // Fallback
    window.addEventListener('deviceorientation', e => {
      if (e.webkitCompassHeading) {
        currentHeading = e.webkitCompassHeading;
      } else if (e.alpha) {
        currentHeading = 360 - e.alpha;
      }
      updateNeedle();
    });
  }
}

