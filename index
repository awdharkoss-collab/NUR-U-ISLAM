function renderSurahs() {
  const list = document.getElementById('surah-list');
  list.innerHTML = surahs.map(s => `
    <div class="surah-item" onclick="openSurah(${s.n}, '${s.name}')">
      <div style="display:flex; align-items:center; gap:15px;">
        <div class="surah-num">${s.n}</div>
        <div>
          <strong>${s.name}</strong>
          <div style="font-size:0.85rem; color:var(--muted);">${s.ayet} Ayet</div>
        </div>
      </div>
      <span class="badge ${s.type === 'Medenî' ? 'medeni' : ''}">${s.type}</span>
    </div>
  `).join('');
}

async function openSurah(num, name) {
  const modal = document.getElementById('surahModal');
  const title = document.getElementById('modalTitle');
  const content = document.getElementById('modalContent');
  
  title.textContent = `${num}. ${name} Suresi`;
  content.innerHTML = '<p style="text-align:center; padding:40px;">Yükleniyor...</p>';
  modal.style.display = 'block';

  try {
    // Arapça + Türkçe meal
    const [arRes, trRes] = await Promise.all([
      fetch(`https://api.alquran.cloud/v1/surah/${num}/quran-uthmani`),
      fetch(`https://api.alquran.cloud/v1/surah/${num}/tr.diyanet`)
    ]);
    
    const arData = await arRes.json();
    const trData = await trRes.json();

    let html = '';
    arData.data.ayahs.forEach((ayah, i) => {
      html += `
        <div style="margin-bottom:30px; padding-bottom:20px; border-bottom:1px solid rgba(212,175,55,0.15);">
          <div class="arabic">${ayah.text} <span style="font-size:0.9rem; color:var(--gold);">﴿${ayah.numberInSurah}﴾</span></div>
          <p style="color:var(--text); line-height:1.7;">${trData.data.ayahs[i].text}</p>
        </div>
      `;
    });
    content.innerHTML = html;
  } catch (e) {
    content.innerHTML = '<p style="color:#e74c3c;">İnternet bağlantısı gerekli. Lütfen tekrar deneyin.</p>';
  }
}

